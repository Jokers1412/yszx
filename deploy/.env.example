# 云枢智学 · docker-compose 环境变量示例
# 用法：复制为 deploy/.env 后按需修改；未设置的变量使用 compose 内默认值（仅供开发）。
# 端口默认值为本机开发推荐值（避开常见本机原生服务占用：MySQL 3306 / Redis 6379）。

# ---- MySQL ----
# 3307：避让本机原生 MySQL 的 3306
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=yszx_root_2026

# ---- Redis ----
# 6380：避让本机原生 redis-server 的 6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=yszx_redis_2026

# ---- MinIO ----
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=yszx_minio_2026
MINIO_BUCKET=yszx-assets
