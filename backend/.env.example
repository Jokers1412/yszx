# 云枢智学 · 后端环境变量（复制为 .env 后按需修改；默认值对齐 deploy/.env 本机开发环境）

# ---- 应用 ----
APP_NAME=云枢智学
DEBUG=true

# ---- MySQL（deploy/docker-compose.yml，宿主端口 3307，UTC 时区）----
DATABASE_URL=mysql+aiomysql://root:yszx_root_2026@127.0.0.1:3307/yszx?charset=utf8mb4

# ---- Redis ----
# 6380：deploy 映射的宿主端口（避让本机原生 redis-server 的 6379）
REDIS_URL=redis://:yszx_redis_2026@127.0.0.1:6380/0

# ---- MinIO（S3 兼容）----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=yszx_minio_2026
MINIO_BUCKET=yszx-assets
MINIO_SECURE=false

# ---- JWT（两端独立密钥/受众，02 D3）----
JWT_SECRET_PORTAL=dev-portal-secret-change-me
JWT_SECRET_ADMIN=dev-admin-secret-change-me
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_TTL_DAYS_REMEMBER=30

# ---- 外部服务（适配器抽象，联调期 Mock，02 D5/D17）----
AI_PROVIDER=mock
SMS_PROVIDER=mock
