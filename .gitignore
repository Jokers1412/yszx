# ============================================================
# 根级忽略规则（子目录另有 backend/.gitignore、frontend/.gitignore）
# ============================================================

# ---- 本地环境变量：含密码/密钥，禁止入库（模板统一为 *.example 提交）----
.env

# ---- Claude Code 本地配置（个人权限设置，不入库）----
.claude/settings.local.json

# ---- 依赖与构建产物（安全网，以子目录规则为主）----
node_modules/
.venv/
__pycache__/
dist/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db
